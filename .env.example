# Copy to .env and adjust. Loaded by src/neurogeom/config.py via python-dotenv.
# Where Hugging Face model weights are cached (8B models need ~16 GB).
HF_HOME=D:/AI/hf_cache
# Optional: HF token (otherwise the token from `hf auth login` is used). Never commit a real token.
# HF_TOKEN=
# Device for training/inference.
NEUROGEOM_DEVICE=cuda
# Hugging Face repo id for uploading the trained fitter.
NEUROGEOM_HF_REPO=BurnyCoder/neurogeom-shape-fitter
